# Server
SERVER_PORT=8080
GIN_MODE=debug        # debug | release | test
SERVER_READ_TIMEOUT=30
SERVER_WRITE_TIMEOUT=30
SERVER_SHUTDOWN_TIMEOUT=5

# TimescaleDB (PostgreSQL-compatible)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=pawonwarga
DB_SSLMODE=disable
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=100

# Redis Cache
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Basic Auth (for non-user API routes)
AUTH_USERNAME=admin
AUTH_PASSWORD=secret

# JWT (for user auth routes)
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRY_HOURS=24

# Ingest API key (for the internal /api/v1/ingest routes — Python labeling worker)
INGEST_API_KEY=change-this-to-a-long-random-secret

# Object Storage (S3-compatible)
# --- idcloudhost ---
STORAGE_ENDPOINT=https://is3.cloudhost.id
STORAGE_REGION=id-jkt-1
STORAGE_BUCKET=your-bucket-name
STORAGE_ACCESS_KEY_ID=your-access-key
STORAGE_SECRET_ACCESS_KEY=your-secret-key
STORAGE_PUBLIC_BASE_URL=https://your-bucket-name.is3.cloudhost.id
STORAGE_FORCE_PATH_STYLE=false
#
# --- AWS S3 (to migrate later) ---
# STORAGE_ENDPOINT=         (leave empty for real AWS)
# STORAGE_REGION=ap-southeast-1
# STORAGE_BUCKET=your-bucket-name
# STORAGE_ACCESS_KEY_ID=your-access-key
# STORAGE_SECRET_ACCESS_KEY=your-secret-key
# STORAGE_PUBLIC_BASE_URL=https://your-bucket-name.s3.ap-southeast-1.amazonaws.com
# STORAGE_FORCE_PATH_STYLE=false
